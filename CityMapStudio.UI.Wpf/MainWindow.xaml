<Window x:Class="CityMapStudio.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ht="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:CityMapStudio.UI.Wpf"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" Height="900" Width="1600"
        Loaded="MainWindow_Loaded"
        Background="#1E1E1E">
    
    <DockPanel Background="#2D2D30">
        
        <!-- ===== TOP TOOLBAR ===== -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="50" Background="#3C3C42" Margin="0">
            <!-- Logo/Title -->
            <TextBlock Text="{DynamicResource AppTitle}" VerticalAlignment="Center" Margin="15,0" FontSize="14" FontWeight="Bold" Foreground="White"/>
            
            <Separator Width="1" Background="#555555" Margin="0"/>
            
            <!-- Quick Actions -->
            <Button Content="{DynamicResource New}" Margin="10,5" Padding="12,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            <Button Content="{DynamicResource Open}" Margin="5,5" Padding="12,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            <Button Command="{Binding GenerateTestTerrainCommand}" Content="{DynamicResource TestMap}" Margin="5,5" Padding="12,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            <Button Content="{DynamicResource ImportPNG}" Margin="5,5" Padding="12,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            <Button Command="{Binding ExportPackageCommand}" Content="{DynamicResource ExportCS2}" Margin="5,5" Padding="12,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsHeightmapLoaded}"/>
            
            <Separator Width="1" Background="#555555" Margin="10,0"/>
            
            <!-- Undo/Redo -->
            <Button Content="{DynamicResource Undo}" Margin="5,5" Padding="10,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            <Button Content="{DynamicResource Redo}" Margin="5,5" Padding="10,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand"/>
            
            <!-- Status -->
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="#B0B0B0"/>
            <TextBlock Text="{Binding LodIndicator}" VerticalAlignment="Center" Margin="10,0" Foreground="#888888" FontSize="11"/>
        </StackPanel>
        
        <!-- ===== STATUS BAR (Bottom) ===== -->
        <StatusBar DockPanel.Dock="Bottom" Height="30" Background="#3C3C42">
            <TextBlock Text="{Binding HeightmapInfo}" Margin="10,0" Foreground="#B0B0B0"/>
            <Separator Width="1" Background="#555555"/>
            <TextBlock Text="{Binding PreviewInfo}" Margin="10,0" Foreground="#888888" FontSize="10"/>
        </StatusBar>
        
        <!-- ===== MAIN CONTENT (Left/Center/Right) ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            
            <!-- LEFT PANEL - Editor Categories -->
            <StackPanel Grid.Column="0" Background="#252526" Margin="0">
                <TextBlock Text="{DynamicResource Editor}" Foreground="#008000" FontSize="11" FontWeight="Bold" Margin="12,15,12,10"/>
                
                <!-- Terrain Category -->
                <Button x:Name="TerrainCategoryBtn" Content="{DynamicResource TerrainCategory}" Tag="Terrain" Click="Category_Click" Margin="8,3" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" FontSize="11"/>
                
                <!-- Water Category -->
                <Button x:Name="WaterCategoryBtn" Content="{DynamicResource WaterCategory}" Tag="Water" Click="Category_Click" Margin="8,3" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" FontSize="11"/>
                
                <!-- Resources Category -->
                <Button x:Name="ResourcesCategoryBtn" Content="{DynamicResource ResourcesCategory}" Tag="Resources" Click="Category_Click" Margin="8,3" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" FontSize="11"/>
                
                <!-- Utilities Category -->
                <Button x:Name="UtilitiesCategoryBtn" Content="{DynamicResource UtilitiesCategory}" Tag="Utilities" Click="Category_Click" Margin="8,3" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" FontSize="11"/>
                
                <Separator Margin="8,10" Background="#444444"/>
                
                <!-- Map Info -->
                <TextBlock Text="{DynamicResource MapInfo}" Foreground="#008000" FontSize="10" FontWeight="Bold" Margin="12,8,12,5"/>
                <TextBlock x:Name="MapInfoText" Text="{DynamicResource NoHeightmap}" Margin="10,5,10,10" FontSize="9" Foreground="#888888" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- CENTER - Viewport 3D -->
            <ht:HelixViewport3D Grid.Column="1" x:Name="Viewport3D" 
                                Background="#1E1E1E"
                                ShowViewCube="True" 
                                ShowCoordinateSystem="True"
                                Margin="0">
                
                <!-- Lighting -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <!-- Main directional light (45 degrees) -->
                            <DirectionalLight Direction="0.7, -1, 0.5" Color="White" />
                            <!-- Ambient light for shadows -->
                            <AmbientLight Color="#666666" />
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                
                <!-- Terrain Mesh -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding TerrainMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#4A7C3A" />
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <DiffuseMaterial Brush="#3A6A2A" />
                            </GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                
                <!-- Water Mesh -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding WaterMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#3D8DC9" />
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </ht:HelixViewport3D>
            
            <!-- RIGHT PANEL - Tool Inspector -->
            <ScrollViewer Grid.Column="2" Background="#252526" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="InspectorPanel" Margin="0" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
</Window>
