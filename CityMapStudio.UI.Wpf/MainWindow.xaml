<Window x:Class="CityMapStudio.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ht="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:CityMapStudio.UI.Wpf"
        Title="CityMapStudio - Editor de Mapas" 
        Height="900" 
        Width="1600"
        Loaded="MainWindow_Loaded"
        Background="#1E1E1E"
        Foreground="#B0B0B0">

    <DockPanel Background="#2D2D30">
        
        <!-- TOP MENU -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#3C3C42" Margin="10,0">
            <Button Content="New" Margin="0,0,10,0" Padding="15,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Open" Margin="0,0,10,0" Padding="15,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Test" Command="{Binding GenerateTestTerrainCommand}" Margin="0,0,10,0" Padding="15,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Import PNG" Margin="0,0,10,0" Padding="15,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Export CS2" Command="{Binding ExportPackageCommand}" Margin="0,0,10,0" Padding="15,8" Background="Transparent" Foreground="#B0B0B0" BorderThickness="1" BorderBrush="#555555" IsEnabled="{Binding IsHeightmapLoaded}"/>
            
            <Separator Width="1" Background="#555555" Margin="10,0"/>
            
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0" Foreground="#B0B0B0"/>
            <TextBlock Text="{Binding LodIndicator}" VerticalAlignment="Center" Margin="20,0" Foreground="#888888" FontSize="10"/>
        </StackPanel>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#3C3C42">
            <TextBlock Text="{Binding HeightmapInfo}" Margin="10,0" Foreground="#B0B0B0" FontSize="11"/>
            <Separator Width="1" Background="#555555" Margin="5,0"/>
            <TextBlock Text="{Binding PreviewInfo}" Margin="10,0" Foreground="#888888" FontSize="10"/>
        </StatusBar>

        <!-- MAIN CONTENT -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <StackPanel Grid.Column="0" Background="#252526" Margin="10">
                <TextBlock Text="EDITOR" Foreground="#008000" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Button x:Name="TerrainBtn" Content="Terrain" Tag="Terrain" Click="Category_Click" 
                        Margin="0,0,0,5" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" 
                        BorderThickness="1" BorderBrush="#555555" HorizontalAlignment="Stretch"/>
                
                <Button x:Name="WaterBtn" Content="Water" Tag="Water" Click="Category_Click" 
                        Margin="0,0,0,5" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" 
                        BorderThickness="1" BorderBrush="#555555" HorizontalAlignment="Stretch"/>
                
                <Button x:Name="ResourcesBtn" Content="Resources" Tag="Resources" Click="Category_Click" 
                        Margin="0,0,0,5" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" 
                        BorderThickness="1" BorderBrush="#555555" HorizontalAlignment="Stretch"/>
                
                <Button x:Name="UtilitiesBtn" Content="Utilities" Tag="Utilities" Click="Category_Click" 
                        Margin="0,0,0,15" Padding="10,8" Background="#3C3C42" Foreground="#B0B0B0" 
                        BorderThickness="1" BorderBrush="#555555" HorizontalAlignment="Stretch"/>

                <Separator Background="#444444" Margin="0,10"/>

                <TextBlock Text="MAP INFO" Foreground="#008000" FontSize="11" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock x:Name="MapInfo" Text="No map loaded" Margin="0,5,0,0" FontSize="9" 
                           Foreground="#888888" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- CENTER - VIEWPORT -->
            <ht:HelixViewport3D Grid.Column="1" x:Name="Viewport3D" 
                                Background="#1E1E1E"
                                ShowViewCube="True" 
                                ShowCoordinateSystem="True">
                
                <!-- Lighting -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <DirectionalLight Direction="0.7, -1, 0.5" Color="White"/>
                            <AmbientLight Color="#666666"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Terrain -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding TerrainMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#4A7C3A"/>
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <DiffuseMaterial Brush="#3A6A2A"/>
                            </GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Water -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding WaterMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#3D8DC9"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </ht:HelixViewport3D>

            <!-- RIGHT PANEL -->
            <ScrollViewer Grid.Column="2" Background="#252526" Margin="10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InspectorPanel"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
