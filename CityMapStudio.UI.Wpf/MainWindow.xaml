<Window x:Class="CityMapStudio.UI.Wpf.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:ht="http://helix-toolkit.org/wpf"
xmlns:local="clr-namespace:CityMapStudio.UI.Wpf"
mc:Ignorable="d"
Title="CityMapStudio 3D" Height="800" Width="1200"
Loaded="MainWindow_Loaded">
    
    <DockPanel>
        <!-- Toolbar top -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Background="#F0F0F0" Margin="5">
            <Button Command="{Binding GenerateTestTerrainCommand}" 
                    Content="Generate Test Terrain" 
                    Padding="10,5" 
                    Margin="5,0"/>
            <Button x:Name="ImportHeightmapButton"
                    Content="Import Heightmap (PNG 16-bit)" 
                    Padding="10,5" 
                    Margin="5,0"
                    Background="#2196F3"
                    Foreground="White"
                    Click="ImportHeightmapButton_Click"/>
            <Button Command="{Binding ExportPackageCommand}"
                    Content="Export Package (CS2)"
                    Padding="10,5"
                    Margin="5,0"
                    Background="#FF9800"
                    Foreground="White"
                    IsEnabled="{Binding IsHeightmapLoaded}"/>
            <Separator Width="1" Margin="5,0" Background="#CCCCCC"/>
            <TextBlock Text="{Binding StatusText}" 
                       VerticalAlignment="Center" 
                       Margin="10,0" 
                       Foreground="#333333"/>
            <TextBlock Text="? Carregando..." 
                       VerticalAlignment="Center" 
                       Margin="10,0" 
                       Foreground="#FF9800"
                       FontWeight="Bold"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Status bar bottom -->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#F0F0F0">
            <TextBlock Text="{Binding HeightmapInfo}" Margin="5,0"/>
        </StatusBar>

        <!-- Main layout: Viewport3D + Right panel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- 3D Viewport -->
            <ht:HelixViewport3D Grid.Column="0"
                                x:Name="Viewport3D"
                                Background="#2D2D30"
                                ShowViewCube="True"
                                ShowCoordinateSystem="True">
                <ht:DefaultLights />
                
                <!-- Terrain 3D Model -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding TerrainMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#2E7D32" />
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <DiffuseMaterial Brush="#558B2F" />
                            </GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Water 3D Model -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding WaterMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#4DB8FF" />
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </ht:HelixViewport3D>

            <!-- Right panel -->
            <StackPanel Grid.Column="1" Background="#F5F5F5" Margin="0,5,5,5">
                <TextBlock Text="Terrain Settings" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Margin="10,10,10,5" 
                           Foreground="#333333"/>
                
                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Vertical Scale Slider -->
                <TextBlock Text="Vertical Scale (m)" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <Slider Margin="10,0,10,5"
                        Minimum="10"
                        Maximum="200"
                        Value="{Binding VerticalScale}"
                        TickPlacement="BottomRight"
                        TickFrequency="10"/>
                <TextBlock Text="{Binding VerticalScale, StringFormat='{}{0:F1}m'}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextAlignment="Center"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Preview Resolution Selector -->
                <TextBlock Text="Preview Resolution" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <ComboBox Margin="10,0,10,5"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedPreviewResolution}"
                          IsEnabled="{Binding IsHeightmapLoaded}"
                          Foreground="#333333">
                    <ComboBoxItem>256</ComboBoxItem>
                    <ComboBoxItem>512</ComboBoxItem>
                    <ComboBoxItem>1024</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="{Binding PreviewInfo}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="10"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Render Resolution Slider -->
                <TextBlock Text="Render Resolution" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <Slider Margin="10,0,10,5"
                        Minimum="64"
                        Maximum="4096"
                        Value="{Binding RenderResolution}"
                        TickPlacement="BottomRight"
                        IsEnabled="{Binding IsHeightmapLoaded}"
                        TickFrequency="256"/>
                <TextBlock Text="{Binding RenderResolution, StringFormat='{}{0:F0}x{0:F0}'}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextAlignment="Center"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Smooth Level Slider -->
                <TextBlock Text="Smooth Level" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <Slider Margin="10,0,10,5"
                        Minimum="0"
                        Maximum="3"
                        Value="{Binding SmoothLevel}"
                        IsEnabled="{Binding IsHeightmapLoaded}"
                        TickPlacement="BottomRight"
                        TickFrequency="1"/>
                <TextBlock Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}">
                            <Binding Path="SmoothLevel"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Target Max Height Slider -->
                <TextBlock Text="Target Max Height (CS2)" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <Slider Margin="10,0,10,5"
                        Minimum="50"
                        Maximum="1000"
                        Value="{Binding TargetMaxHeight}"
                        IsEnabled="{Binding IsHeightmapLoaded}"
                        TickPlacement="BottomRight"
                        TickFrequency="50"/>
                <TextBlock Text="{Binding TargetMaxHeight, StringFormat='{}{0:F0}m'}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextAlignment="Center"/>

                <!-- Normalize Checkbox -->
                <CheckBox Margin="10,5,10,10"
                          IsChecked="{Binding NormalizeForCS2}"
                          IsEnabled="{Binding IsHeightmapLoaded}"
                          Content="Normalize for CS2 Colors"
                          Foreground="#666666"
                          FontSize="11"/>

                <!-- Apply Smooth on Export Checkbox -->
                <CheckBox Margin="10,5,10,10"
                          IsChecked="{Binding ApplySmoothOnExport}"
                          IsEnabled="{Binding IsHeightmapLoaded}"
                          Content="Apply Smooth on Export"
                          Foreground="#666666"
                          FontSize="11"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>
                <TextBlock Text="Sea Level" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <Slider Margin="10,0,10,5"
                        Minimum="{Binding SeaLevelMin}"
                        Maximum="{Binding SeaLevelMax}"
                        Value="{Binding SeaLevel}"
                        TickPlacement="BottomRight"
                        IsEnabled="{Binding IsHeightmapLoaded}"
                        TickFrequency="5"/>
                <TextBlock Text="{Binding SeaLevelInfo}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextAlignment="Center"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Heightmap Info -->
                <TextBlock Text="Heightmap" 
                           Margin="10,10,10,5" 
                           Foreground="#666666"
                           FontSize="12"/>
                <TextBlock Text="{Binding HeightmapInfo}" 
                           Margin="10,0,10,10" 
                           Foreground="#999999"
                           FontSize="11"
                           TextWrapping="Wrap"/>

                <!-- Separator -->
                <Separator Margin="5,0"/>

                <!-- Reset Camera Button -->
                <Button Command="{Binding ResetCameraCommand}"
                        Content="Reset Camera"
                        Padding="10,8"
                        Margin="10,0,10,10"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
